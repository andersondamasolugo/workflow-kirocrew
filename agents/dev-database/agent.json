{
  "name": "dev-database",
  "description": "Base de datos: esquemas, migraciones, indices, politicas de datos. Ejecuta flow-data-migration.",
  "model": "auto",
  "prompt": "file://~/.kiro/crew/agents/dev-database/prompt.md",
  "resources": [
    "skill://~/.kiro/crew/skills/flow-data-migration/SKILL.md"
  ],
  "mcpServers": {
    "kirocrew-core": {
      "command": "kirocrew",
      "args": [
        "mcp",
        "core"
      ]
    }
  },
  "tools": [
    "@kirocrew-core",
    "glob",
    "grep",
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "glob",
    "@kirocrew-core"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "kirocrew-core/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  }
}
